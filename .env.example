LYRA_HTTP_ADDRESS=:8080
LYRA_ALLOWED_ORIGIN=http://localhost:5173
LYRA_MAX_IDENTIFY_BYTES=10485760
LYRA_ADMIN_USERNAME=admin
# Generate with: htpasswd -bnBC 12 "" 'replace-this-password' | tr -d ':\n'
# Never commit a real password or this resulting hash.
LYRA_ADMIN_PASSWORD_HASH=
# false only for localhost HTTP development. Set true for every deployed environment.
LYRA_ADMIN_COOKIE_SECURE=false
DATABASE_URL=postgres://lyra:lyra@localhost:5432/lyra?sslmode=disable
REDIS_ADDR=localhost:6379
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=lyra-minio
S3_SECRET_KEY=lyra-minio-secret
S3_BUCKET=lyra-reference
S3_SECURE=false
